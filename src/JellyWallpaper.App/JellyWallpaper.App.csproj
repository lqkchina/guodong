<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JellyWallpaper 果冻弹性壁纸 - Windows 应用工程
    =====================================================================
    技术栈（v3 定稿，全部使用 Windows 10 系统自带 API，避免 WinAppSDK
    运行时部署问题）：
      * C# / .NET 8（net8.0-windows10.0.19041.0，Win10 2004+）
      * Microsoft.Graphics.Win2D 1.2.2 —— Direct2D 渲染（微软官方 NuGet）
      * Windows.UI.Composition（系统内置 DWM 合成 API，Win10 1709+ 自带）：
          - 桌面挂载：ICompositorDesktopInterop + CompositionTarget
            （动态壁纸工具的标准方案，Win10/Win11 全系稳定）
          - 渲染表面：CompositionGraphicsDevice / CompositionDrawingSurface /
            CompositionSurfaceBrush / SpriteVisual
      * Windows.System.DispatcherQueue（系统内置调度队列，Win10 1709+ 自带）
      * WPF 设置窗口 + WinForms 托盘图标

    为什么不用 Microsoft.WindowsAppSDK（v1/v2 的血泪教训）：
      * v1（ContentIsland/DesktopChildSiteBridge）：WinAppSDK 1.6 的
        DesktopChildSiteBridge 在 Win10 上实测原生崩溃（AccessViolation）；
      * v2（ICompositorDesktopInterop + CompositionTarget）：Microsoft.UI.Composition
        的 C# 投影里根本没有 CompositionTarget 类型（CS0246）；
      * 且 WinAppSDK unpackaged 部署依赖运行时激活清单，容易 0x80040154。
      Windows.UI.Composition（系统版）无上述任何问题，且无需任何运行时部署。

    发布配置：dotnet publish 目录版（绿色免安装文件夹，双击 exe 即用）。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JellyWallpaper.App</RootNamespace>
    <AssemblyName>JellyWallpaper</AssemblyName>

    <!-- WPF 设置窗口 + WinForms 托盘图标 -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- 目标平台：Win2D 原生组件仅支持 x64 -->
    <PlatformTarget>x64</PlatformTarget>

    <!-- 每显示器 V2 DPI 感知（见 app.manifest） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 独立发布（目录版）：自带 .NET 运行时，绿色免安装 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!--
      NuGet 包清单（v3）：
        Microsoft.Graphics.Win2D 1.2.2 —— 最后一个面向系统版
        Windows.UI.Composition 的 Win2D 版本（1.3.x 改投 WinAppSDK）。
        不依赖 Windows App SDK，无运行时部署负担。
    -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JellyWallpaper.Core\JellyWallpaper.Core.csproj" />
  </ItemGroup>

</Project>
