<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JellyWallpaper 果冻弹性壁纸 - Windows 应用工程
    =====================================================================
    技术栈（与需求一致）：
      * C# / .NET 8
      * CsWinRT（Microsoft.WindowsAppSDK 1.6 自带的 WinRT 投影）
      * Microsoft.Graphics.DirectX + Direct2D（Microsoft.Graphics.Win2D 1.3.2，
        这是微软官方基于 Direct2D 的 WinRT 封装，CanvasSwapChain 即
        IDXGISwapChain 的组合交换链）
      * WPF 设置窗口 + WinForms 托盘图标
      * Windows.UI.Composition 等价物：Microsoft.UI.Composition（WinAppSDK 版
        视觉层，通过 ICompositorDesktopInterop 挂到桌面窗口）

    发布配置（VS2022 一键发布为独立单文件 EXE，自带 .NET 运行时）：
      RuntimeIdentifier=win-x64 + SelfContained + PublishSingleFile
      + WindowsAppSDKSelfContained（WinAppSDK 运行时也打进去，绿色免安装）
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JellyWallpaper.App</RootNamespace>
    <AssemblyName>JellyWallpaper</AssemblyName>

    <!-- WPF 设置窗口 + WinForms 托盘图标 -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- 目标平台：Win2D / WinAppSDK 原生组件仅支持 x64 -->
    <PlatformTarget>x64</PlatformTarget>

    <!-- 每显示器 V2 DPI 感知（见 app.manifest） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 独立单文件发布（默认开启；VS2022 直接 F5 调试、Ctrl+P 发布） -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>

    <!-- WinAppSDK：免安装（非 MSIX 打包） + 自包含运行时。
         EnableMsixTooling 必须为 true：WinAppSDK 的构建工具链（PRI 资源生成等）
         依赖它，且 PublishSingleFile 明确要求 EnableMsixTooling=true；
         WindowsPackageType=None 依然保证产出 unpackaged 免安装应用。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!--
      NuGet 包清单（版本为官方兼容组合，已核对依赖关系）：
        Microsoft.WindowsAppSDK 1.6.250602001 —— CsWinRT / Composition / DispatcherQueue
        Microsoft.Graphics.Win2D 1.3.2      —— Direct2D 渲染（依赖 WinAppSDK 1.6.x）
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JellyWallpaper.Core\JellyWallpaper.Core.csproj" />
  </ItemGroup>

</Project>
