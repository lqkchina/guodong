<Window x:Class="JellyWallpaper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="果冻弹性壁纸 · 设置"
        Width="470" Height="700" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="ParamSlider" TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 状态 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="果冻弹性壁纸" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="TxtStatus" Text="合成层状态：初始化中…" Foreground="Gray" Margin="0,4,0,0"/>
            <TextBlock Text="提示：在桌面空白处按住左键拖拽壁纸即可看到果冻形变，松开自动回弹" 
                       Foreground="DimGray" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 开关 -->
        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <CheckBox x:Name="CbEffect" Content="启用果冻效果" FontSize="14"
                      Checked="CbEffect_Changed" Unchecked="CbEffect_Changed"/>
            <CheckBox x:Name="CbFollow" Content="跟随系统壁纸（取消后使用纯色背景）" FontSize="14"
                      Margin="0,6,0,0"
                      Checked="CbFollow_Changed" Unchecked="CbFollow_Changed"/>
        </StackPanel>

        <!-- 物理参数滑条 -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="物理参数（修改立即生效）" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <!-- ① 网格尺寸 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="网格尺寸" Grid.Column="0"/>
                <TextBlock x:Name="LblGrid" Grid.Column="1" Text="32 px" Foreground="Gray"/>
            </Grid>
            <Slider x:Name="SGrid" Minimum="12" Maximum="120" Style="{StaticResource ParamSlider}"
                    ValueChanged="SGrid_Changed"/>

            <!-- ② 弹簧刚度 -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="弹簧刚度 Stiffness（回弹力度）" Grid.Column="0"/>
                <TextBlock x:Name="LblStiffness" Grid.Column="1" Text="120" Foreground="Gray"/>
            </Grid>
            <Slider x:Name="SStiffness" Minimum="5" Maximum="400" Style="{StaticResource ParamSlider}"
                    ValueChanged="SStiffness_Changed"/>

            <!-- ③ 阻尼 -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="阻尼 Damping（抑制震荡）" Grid.Column="0"/>
                <TextBlock x:Name="LblDamping" Grid.Column="1" Text="0.25" Foreground="Gray"/>
            </Grid>
            <Slider x:Name="SDamping" Minimum="0" Maximum="0.5" TickFrequency="0.01"
                    Style="{StaticResource ParamSlider}" ValueChanged="SDamping_Changed"/>

            <!-- ④ 拖拽影响半径 -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="拖拽影响半径" Grid.Column="0"/>
                <TextBlock x:Name="LblDragRadius" Grid.Column="1" Text="220 px" Foreground="Gray"/>
            </Grid>
            <Slider x:Name="SDragRadius" Minimum="50" Maximum="800" Style="{StaticResource ParamSlider}"
                    ValueChanged="SDragRadius_Changed"/>

            <!-- ⑤ 拖拽强度 -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="拖拽强度系数" Grid.Column="0"/>
                <TextBlock x:Name="LblDragStrength" Grid.Column="1" Text="0.85" Foreground="Gray"/>
            </Grid>
            <Slider x:Name="SDragStrength" Minimum="0.1" Maximum="3" TickFrequency="0.01"
                    Style="{StaticResource ParamSlider}" ValueChanged="SDragStrength_Changed"/>

            <!-- ⑥ 最大位移 -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="质点最大位移限制（防极端扭曲）" Grid.Column="0"/>
                <TextBlock x:Name="LblMaxDisp" Grid.Column="1" Text="160 px" Foreground="Gray"/>
            </Grid>
            <Slider x:Name="SMaxDisp" Minimum="20" Maximum="600" Style="{StaticResource ParamSlider}"
                    ValueChanged="SMaxDisp_Changed"/>

            <TextBlock x:Name="TxtStatusDetail" Foreground="DimGray" FontSize="12"
                       Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="配置保存位置：%APPDATA%\JellyWallpaper\config.json"/>
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="恢复默认" Width="90" Margin="0,0,10,0" Padding="8,5" Click="BtnReset_Click"/>
            <Button Content="保存配置" Width="90" Padding="8,5" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
